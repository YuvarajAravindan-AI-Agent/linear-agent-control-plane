# Copy to .env and fill from Linear:
#   Settings -> API -> Applications -> Agent Control Plane
# .env is gitignored. On contabo it lives at /opt/linear-agents/.env, chmod 600.

# Shown in full on the application page.
LINEAR_CLIENT_ID=

# Masked on the application page - use the copy button next to "Client secret".
LINEAR_CLIENT_SECRET=

# The lin_wh_... value under "Webhook signing secret".
# This is what src/verify.ts checks every inbound delivery against.
LINEAR_WEBHOOK_SECRET=

# Where Linear sends AgentSessionEvent deliveries. Must match the app config.
PUBLIC_BASE_URL=https://your-host.example.com

PORT=3000
DB_PATH=./data/events.db

# replay = fixtures, zero token spend, the default and what CI runs.
# live    = real model calls, subject to the caps below.
MODE=replay

# Only read when MODE=live.
ANTHROPIC_API_KEY=
MAX_CONCURRENT_AGENTS=3
MAX_TURNS_PER_PACKAGE=20
SPEND_CEILING_USD=5.00

# Who a review gate notifies. No delivery channel is wired yet (no Slack/email) -
# this only labels the notification rows gate.ts computes.
GATE_REVIEWER_ID=founder
# How long a review may sit before it would escalate. Nothing currently calls
# sweep() on a timer in production, so this has no effect yet - see RUNBOOK.
GATE_SLA_MS=86400000
