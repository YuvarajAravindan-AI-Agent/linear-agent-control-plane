# Append to /etc/caddy/Caddyfile on contabo-tally, then `systemctl reload caddy`.
# Requires an A record: linear-agents.ai-agentic-enterprises.com -> 169.58.69.167

linear-agents.ai-agentic-enterprises.com {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Linear's AgentSessionEvent deliveries. Linear gives the receiver 5 seconds,
	# so fail fast and let it retry on its own schedule (1m / 1h / 6h) rather than
	# holding the connection open past the budget.
	@webhook path /webhook
	handle @webhook {
		reverse_proxy 127.0.0.1:3001 {
			transport http {
				response_header_timeout 4s
			}
		}
	}

	# The install flow. Visited by a human in a browser, once, and Linear redirects
	# back to /oauth/callback. No timeout squeeze here — the callback does a token
	# exchange against Linear and is allowed to take its time.
	@oauth path /oauth/*
	handle @oauth {
		reverse_proxy 127.0.0.1:3001
	}

	@health path /healthz
	handle @health {
		reverse_proxy 127.0.0.1:3001
	}

	# Everything else never reaches the Node process.
	handle {
		respond "Not found" 404
	}

	log {
		output file /var/log/caddy/linear-agents.log
		format json
	}
}
